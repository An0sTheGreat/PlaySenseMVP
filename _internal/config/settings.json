{
  "app_name": "PlaySense",
  "hotkey": "<f8>",
  "wake_phrases": [
    "hey playsense",
    "hey gamechat"
  ],
  "spoiler_level": "low",
  "assistant_style": "short, direct, practical, no spoilers unless asked",
  "ai_provider": "gemini",
  "providers": {
    "gemini": {
      "api_key": "",
      "model": "gemini-2.5-flash",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta"
    },
    "openai": {
      "api_key": "",
      "model": "gpt-4.1-mini"
    },
    "openrouter": {
      "api_key": "",
      "model": "google/gemini-2.5-flash",
      "base_url": "https://openrouter.ai/api/v1"
    },
    "custom_openai": {
      "api_key": "",
      "model": "",
      "base_url": ""
    },
    "ollama": {
      "api_key": "ollama",
      "model": "llava:latest",
      "base_url": "http://localhost:11434/v1"
    }
  },
  "openai_model": "gpt-4.1-mini",
  "openai_api_key": "",
  "obs": {
    "host": "127.0.0.1",
    "port": 4455,
    "password": "1234567",
    "replay_folder": "X:/=RECORDINGS=",
    "video_extensions": [
      ".mp4",
      ".mkv",
      ".mov",
      ".flv"
    ]
  },
  "capture": {
    "screenshot_monitor": 1,
    "output_folder": "captures"
  },
  "audio": {
    "question_seconds": 8,
    "wake_chunk_seconds": 3,
    "sample_rate": 16000,
    "whisper_model": "base",
    "device": "cpu",
    "compute_type": "int8"
  },
  "response": {
    "max_words": 220,
    "speak_response": true
  },
  "tts": {
    "rate": 0,
    "volume": 100,
    "voice_name": ""
  }
}