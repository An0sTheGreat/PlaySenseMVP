# PlaySense API keys. Do not share this file publicly.

# Recommended free starter provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional OpenRouter provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional custom OpenAI-compatible provider
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Optional local Ollama OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llava:latest

# gemini, openai, openrouter, custom_openai, or ollama
PLAYSENSE_AI_PROVIDER=gemini
